#!/usr/bin/env groovy
/**
 * msbuild-project-build
 *
 * Uses Portal /pod-template YAML as the Kubernetes agent definition.
 */
pipeline {
  agent { label 'linux || built-in' }

  options {
    timestamps()
    timeout(time: 2, unit: HOURS)
  }

  parameters {
    string(name: 'BUILD_REQUEST_ID', defaultValue: '', description: 'Portal build request id')
  }

  environment {
    PORTAL_BASE_URL = credentials('portal-base-url')
    PORTAL_HMAC_SECRET = credentials('portal-callback-hmac')
  }

  stages {
    stage('Resolve + Windows build') {
      steps {
        script {
          if (!params.BUILD_REQUEST_ID?.trim()) {
            error('BUILD_REQUEST_ID is required')
          }

          def metaText = sh(
            returnStdout: true,
            script: """
              python3 jenkins/shared-library/scripts/portal_project_agent.py \\
                resolve \\
                --portal-url "\$PORTAL_BASE_URL" \\
                --request-id "\$BUILD_REQUEST_ID"
            """
          ).trim()
          writeFile file: 'request-meta.json', text: metaText
          def meta = readJSON file: 'request-meta.json'
          if (!meta.imageDigest) {
            error("Portal request ${params.BUILD_REQUEST_ID} has no imageDigest yet")
          }

          def podYaml = sh(
            returnStdout: true,
            script: """
              python3 jenkins/shared-library/scripts/portal_project_agent.py \\
                pod-template \\
                --portal-url "\$PORTAL_BASE_URL" \\
                --request-id "\$BUILD_REQUEST_ID" \\
                --format yaml
            """
          ).trim()

          // Keep builder container alive for the Kubernetes plugin.
          if (!podYaml.contains('Start-Sleep')) {
            podYaml = podYaml.replaceFirst(
              /(?m)^(\\s*)name:\\s*builder\\s*$/,
              '''\$1name: builder
\$1command:
\$1  - powershell
\$1args:
\$1  - -Command
\$1  - Start-Sleep -Seconds 86400'''
            )
          }
          writeFile file: 'pod-template.yaml', text: podYaml

          podTemplate(yaml: podYaml) {
            node(POD_LABEL) {
              container('builder') {
                withEnv([
                  "REPO=${meta.repository}",
                  "COMMIT=${meta.resolvedCommit}",
                  "SOLUTION=${meta.solutionPath}",
                  "CONFIGURATION=${meta.configuration ?: 'Release'}",
                  "PLATFORM=${meta.platform ?: 'x64'}",
                  "NUGET_MODE=${meta.nugetMode ?: 'repo-packages-and-internal-feed'}",
                ]) {
                  powershell '''
                    python C:\\portal-tools\\portal_project_agent.py `
                      event `
                      --portal-url $env:PORTAL_BASE_URL `
                      --hmac-secret $env:PORTAL_HMAC_SECRET `
                      --request-id $env:BUILD_REQUEST_ID `
                      --event-type BUILDING `
                      --message "Project build started" `
                      --build-number $env:BUILD_NUMBER

                    Write-Host "Checkout" $env:REPO $env:COMMIT
                    Write-Host "NuGet mode:" $env:NUGET_MODE
                    Write-Host "MSBuild" $env:SOLUTION $env:CONFIGURATION $env:PLATFORM
                    # TODO: real git checkout / nuget restore / msbuild

                    python C:\\portal-tools\\portal_project_agent.py `
                      event `
                      --portal-url $env:PORTAL_BASE_URL `
                      --hmac-secret $env:PORTAL_HMAC_SECRET `
                      --request-id $env:BUILD_REQUEST_ID `
                      --event-type TESTING `
                      --message "Tests running" `
                      --build-number $env:BUILD_NUMBER

                    python C:\\portal-tools\\portal_project_agent.py `
                      event `
                      --portal-url $env:PORTAL_BASE_URL `
                      --hmac-secret $env:PORTAL_HMAC_SECRET `
                      --request-id $env:BUILD_REQUEST_ID `
                      --event-type PUBLISHING `
                      --message "Publishing artifacts" `
                      --build-number $env:BUILD_NUMBER

                    python C:\\portal-tools\\portal_project_agent.py `
                      event `
                      --portal-url $env:PORTAL_BASE_URL `
                      --hmac-secret $env:PORTAL_HMAC_SECRET `
                      --request-id $env:BUILD_REQUEST_ID `
                      --event-type SUCCEEDED `
                      --message "Project build succeeded" `
                      --build-number $env:BUILD_NUMBER
                  '''
                }
              }
            }
          }
        }
      }
    }
  }

  post {
    failure {
      sh '''
        if [ -n "$BUILD_REQUEST_ID" ] && [ -n "$PORTAL_BASE_URL" ]; then
          python3 jenkins/shared-library/scripts/portal_project_agent.py \
            event \
            --portal-url "$PORTAL_BASE_URL" \
            --hmac-secret "$PORTAL_HMAC_SECRET" \
            --request-id "$BUILD_REQUEST_ID" \
            --event-type PROJECT_BUILD_FAILED \
            --message "Jenkins project pipeline failed" \
            --build-number "$BUILD_NUMBER" || true
        fi
      '''
    }
  }
}
