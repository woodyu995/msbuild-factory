#!/usr/bin/env groovy
/**
 * msbuild-project-build
 *
 * Parameters:
 *   BUILD_REQUEST_ID
 *
 * Assumes Portal already resolved a READY image digest.
 * Pod YAML is fetched from Portal (/pod-template) so nodeSelector and digest stay in sync.
 */
pipeline {
  agent none

  options {
    timestamps()
    timeout(time: 2, unit: HOURS)
  }

  parameters {
    string(name: 'BUILD_REQUEST_ID', defaultValue: '', description: 'Portal build request id')
  }

  environment {
    PORTAL_BASE_URL = credentials('portal-base-url')
    PORTAL_HMAC_SECRET = credentials('portal-callback-hmac')
  }

  stages {
    stage('Resolve request + pod template') {
      agent { label 'linux || built-in' }
      steps {
        script {
          if (!params.BUILD_REQUEST_ID?.trim()) {
            error('BUILD_REQUEST_ID is required')
          }
          def meta = sh(
            returnStdout: true,
            script: """
              python3 jenkins/shared-library/scripts/portal_project_agent.py \\
                resolve \\
                --portal-url "\$PORTAL_BASE_URL" \\
                --request-id "\$BUILD_REQUEST_ID"
            """
          ).trim()
          writeFile file: 'request-meta.json', text: meta
          def parsed = readJSON file: 'request-meta.json'
          if (!parsed.imageDigest) {
            error("Portal request ${params.BUILD_REQUEST_ID} has no imageDigest yet")
          }
          env.IMAGE_DIGEST = parsed.imageDigest
          env.WINDOWS_RELEASE = parsed.windowsBase ?: 'ltsc2022'
          env.REPO = parsed.repository
          env.COMMIT = parsed.resolvedCommit
          env.SOLUTION = parsed.solutionPath
          env.CONFIGURATION = parsed.configuration ?: 'Release'
          env.PLATFORM = parsed.platform ?: 'x64'
          env.NUGET_MODE = parsed.nugetMode ?: 'repo-packages-and-internal-feed'

          def podYaml = sh(
            returnStdout: true,
            script: """
              python3 jenkins/shared-library/scripts/portal_project_agent.py \\
                pod-template \\
                --portal-url "\$PORTAL_BASE_URL" \\
                --request-id "\$BUILD_REQUEST_ID" \\
                --format yaml
            """
          ).trim()
          // Keep container alive for Jenkins Kubernetes plugin
          if (!podYaml.contains('command:')) {
            podYaml = podYaml + '''
  # injected by Jenkinsfile for long-running agent container
'''
          }
          writeFile file: 'pod-template.yaml', text: podYaml
          env.POD_TEMPLATE_YAML = podYaml
        }
      }
    }

    stage('Windows build') {
      agent {
        kubernetes {
          yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app.kubernetes.io/name: msbuild-project-build
    build.company.io/request-id: ${params.BUILD_REQUEST_ID}
spec:
  os:
    name: windows
  nodeSelector:
    kubernetes.io/os: windows
    build.company.io/windows-release: ${env.WINDOWS_RELEASE}
    build.company.io/purpose: msbuild
  tolerations:
    - key: build.company.io/windows
      operator: Equal
      value: "true"
      effect: NoSchedule
  imagePullSecrets:
    - name: internal-registry-secret
  containers:
    - name: builder
      image: registry.internal/build/msbuild-profile@${env.IMAGE_DIGEST}
      imagePullPolicy: IfNotPresent
      workingDir: C:\\\\workspace
      command:
        - powershell
      args:
        - -Command
        - Start-Sleep -Seconds 86400
      resources:
        requests:
          cpu: "2"
          memory: 4Gi
          ephemeral-storage: 20Gi
        limits:
          cpu: "8"
          memory: 16Gi
          ephemeral-storage: 80Gi
"""
          defaultContainer 'builder'
        }
      }
      stages {
        stage('Notify BUILDING') {
          steps {
            powershell '''
              python C:\\portal-tools\\portal_project_agent.py `
                event `
                --portal-url $env:PORTAL_BASE_URL `
                --hmac-secret $env:PORTAL_HMAC_SECRET `
                --request-id $env:BUILD_REQUEST_ID `
                --event-type BUILDING `
                --message "Project build started" `
                --build-number $env:BUILD_NUMBER
            '''
          }
        }

        stage('Checkout') {
          steps {
            powershell '''
              Write-Host "Checkout" $env:REPO $env:COMMIT
              # git clone / checkout $env:COMMIT
            '''
          }
        }

        stage('NuGet restore') {
          steps {
            powershell '''
              Write-Host "NuGet mode:" $env:NUGET_MODE
              # nuget/dotnet restore against internal feed only
            '''
          }
        }

        stage('MSBuild') {
          steps {
            powershell '''
              Write-Host "MSBuild" $env:SOLUTION $env:CONFIGURATION $env:PLATFORM
              # msbuild.exe $env:SOLUTION /p:Configuration=$env:CONFIGURATION /p:Platform=$env:PLATFORM
            '''
          }
        }

        stage('Test + Publish') {
          steps {
            powershell '''
              python C:\\portal-tools\\portal_project_agent.py `
                event `
                --portal-url $env:PORTAL_BASE_URL `
                --hmac-secret $env:PORTAL_HMAC_SECRET `
                --request-id $env:BUILD_REQUEST_ID `
                --event-type TESTING `
                --message "Tests running" `
                --build-number $env:BUILD_NUMBER

              python C:\\portal-tools\\portal_project_agent.py `
                event `
                --portal-url $env:PORTAL_BASE_URL `
                --hmac-secret $env:PORTAL_HMAC_SECRET `
                --request-id $env:BUILD_REQUEST_ID `
                --event-type PUBLISHING `
                --message "Publishing artifacts" `
                --build-number $env:BUILD_NUMBER
            '''
          }
        }

        stage('Succeeded') {
          steps {
            powershell '''
              python C:\\portal-tools\\portal_project_agent.py `
                event `
                --portal-url $env:PORTAL_BASE_URL `
                --hmac-secret $env:PORTAL_HMAC_SECRET `
                --request-id $env:BUILD_REQUEST_ID `
                --event-type SUCCEEDED `
                --message "Project build succeeded" `
                --build-number $env:BUILD_NUMBER
            '''
          }
        }
      }
    }
  }

  post {
    failure {
      sh '''
        if [ -n "$BUILD_REQUEST_ID" ] && [ -n "$PORTAL_BASE_URL" ]; then
          python3 jenkins/shared-library/scripts/portal_project_agent.py \
            event \
            --portal-url "$PORTAL_BASE_URL" \
            --hmac-secret "$PORTAL_HMAC_SECRET" \
            --request-id "$BUILD_REQUEST_ID" \
            --event-type PROJECT_BUILD_FAILED \
            --message "Jenkins project pipeline failed" \
            --build-number "$BUILD_NUMBER"
        fi
      '''
    }
  }
}
