# Example environment for Portal ↔ Jenkins wiring (K8s ClusterDNS + Nexus)

# Portal (in-cluster)
PORTAL_DATABASE_URL=postgresql+psycopg://portal:replace-me@postgres.msbuild-portal.svc.cluster.local:5432/portal
PORTAL_CALLBACK_HMAC_SECRET=replace-me
PORTAL_ALLOW_INSECURE_DEFAULTS=false
PORTAL_SIMULATE_WORKERS=false
PORTAL_FACTORY_ENABLED=true
PORTAL_JENKINS_URL=http://jenkins.jenkins.svc.cluster.local:8080/
PORTAL_JENKINS_USERNAME=portal-bot
PORTAL_JENKINS_API_TOKEN=replace-me

# Nexus Docker registry (factory push / worker pull)
# Must resolve on the factory Windows host (not ClusterDNS-only).
PORTAL_REGISTRY_HOST=nexus.company.io:8082
# Optional push DNS override (defaults to PORTAL_REGISTRY_HOST):
# PORTAL_REGISTRY_PUSH_HOST=nexus.company.io:8082
PORTAL_REGISTRY_FINAL_REPO=build/msbuild-profile
PORTAL_REGISTRY_STAGING_REPO=build/msbuild-profile-staging
PORTAL_REGISTRY_PULL_SECRET=nexus-docker-pull

# Git resolve (prod: ls_remote or http_api + require exact)
PORTAL_GIT_RESOLVE_MODE=ls_remote
PORTAL_GIT_URL_TEMPLATE=https://git.internal/{repository}.git
PORTAL_GIT_REQUIRE_EXACT=true

# API auth (name:token:roles comma-separated; roles use | )
PORTAL_REQUIRE_AUTH=true
PORTAL_API_TOKENS=portal-ui:replace-ui-token:builder,jenkins-bot:replace-bot-token:operator|builder
# Mirror jenkins-bot token into Jenkins credential id portal-api-token

# Factory host
IMAGE_FACTORY_LAYOUT_ROOT=\\\\storage\\vs-layouts
IMAGE_FACTORY_INSTALLER_ROOT=\\\\storage\\installers
FACTORY_DRY_RUN=0
NEXUS_REGISTRY_HOST=nexus.nexus.svc.cluster.local:8082
