# Example environment for Portal ↔ Jenkins wiring

# Portal
PORTAL_CALLBACK_HMAC_SECRET=replace-me
PORTAL_ALLOW_INSECURE_DEFAULTS=false
PORTAL_SIMULATE_WORKERS=false
PORTAL_FACTORY_ENABLED=true
PORTAL_JENKINS_URL=https://jenkins.internal/
PORTAL_JENKINS_USERNAME=portal-bot
PORTAL_JENKINS_API_TOKEN=replace-me

# Git resolve (prod: ls_remote or http_api + require exact)
PORTAL_GIT_RESOLVE_MODE=ls_remote
PORTAL_GIT_URL_TEMPLATE=https://git.internal/{repository}.git
# PORTAL_GIT_RESOLVE_MODE=http_api
# PORTAL_GIT_HTTP_BASE_URL=https://git-api.internal
# PORTAL_GIT_TOKEN=replace-me
PORTAL_GIT_REQUIRE_EXACT=true

# API auth (name:token:roles comma-separated; roles use | )
PORTAL_REQUIRE_AUTH=true
PORTAL_API_TOKENS=portal-ui:replace-ui-token:builder,jenkins-bot:replace-bot-token:operator|builder

# Factory host
IMAGE_FACTORY_LAYOUT_ROOT=\\\\storage\\vs-layouts
IMAGE_FACTORY_INSTALLER_ROOT=\\\\storage\\installers
FACTORY_DRY_RUN=0
