# Example environment for Portal ↔ Jenkins wiring

# Portal
PORTAL_CALLBACK_HMAC_SECRET=replace-me
PORTAL_SIMULATE_WORKERS=false
PORTAL_FACTORY_ENABLED=true
PORTAL_JENKINS_URL=https://jenkins.internal/
PORTAL_JENKINS_USERNAME=portal-bot
PORTAL_JENKINS_API_TOKEN=replace-me

# Factory host
IMAGE_FACTORY_LAYOUT_ROOT=\\\\storage\\vs-layouts
IMAGE_FACTORY_INSTALLER_ROOT=\\\\storage\\installers
FACTORY_DRY_RUN=0
