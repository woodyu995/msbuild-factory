# Copy to .env.airgap and fill values for closed-network Docker Portal.
#   cp .env.airgap.example .env.airgap
#   docker compose -f docker-compose.airgap.yml --env-file .env.airgap up -d

# --- Portal bind ---
PORTAL_HOST_PORT=8000

# --- Secrets (change all) ---
PORTAL_CALLBACK_HMAC_SECRET=CHANGE_ME_LONG_RANDOM
PORTAL_API_TOKENS=portal-ui:CHANGE_UI_TOKEN:builder,jenkins-bot:CHANGE_BOT_TOKEN:operator|builder
POSTGRES_PASSWORD=CHANGE_ME_DB

# --- Jenkins (existing in closed network) ---
PORTAL_JENKINS_URL=http://jenkins.internal:8080/
PORTAL_JENKINS_USERNAME=portal-bot
PORTAL_JENKINS_API_TOKEN=CHANGE_ME_JENKINS_TOKEN

# --- Nexus (must resolve from Windows factory host) ---
PORTAL_REGISTRY_HOST=nexus.internal:8082
# PORTAL_REGISTRY_PUSH_HOST=nexus.internal:8082
PORTAL_REGISTRY_FINAL_REPO=build/msbuild-profile
PORTAL_REGISTRY_STAGING_REPO=build/msbuild-profile-staging

# --- Git (optional for image-only test; needed for project build later) ---
PORTAL_GIT_RESOLVE_MODE=placeholder
# PORTAL_GIT_RESOLVE_MODE=ls_remote
# PORTAL_GIT_URL_TEMPLATE=https://git.internal/{repository}.git
# PORTAL_GIT_REQUIRE_EXACT=true
